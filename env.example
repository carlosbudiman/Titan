# Dewaguard Titan — copy to ~/.titan/env, edit, then: source ~/.titan/env
# Any OpenAI-compatible /chat/completions endpoint works.

# --- model ---------------------------------------------------------------
TITAN_LLM_BASE_URL=http://127.0.0.1:11434/v1
TITAN_LLM_MODEL=qwen2.5:14b
#TITAN_LLM_API_KEY=

# --- pacing / OPSEC ------------------------------------------------------
#TITAN_USER_AGENT=Titan-Assessment/0.2.0
#TITAN_RPS=2
#TITAN_MAX_PER_HOST=1
#TITAN_NOISE_PROFILE=balanced

# --- orchestration -------------------------------------------------------
#TITAN_MAX_WORKERS=2
#TITAN_PLANNER_TURNS=12
#TITAN_WORKER_TURNS=40
#TITAN_MAX_ROUNDS=200
#TITAN_TASK_DEADLINE=0

# --- paths ---------------------------------------------------------------
#TITAN_HOME=$HOME/.titan
#TITAN_SKILL_DIR=$HOME/Dewaguard/Titan/skills

# --- console -------------------------------------------------------------
#TITAN_CONSOLE_BIND=127.0.0.1
#TITAN_CONSOLE_PORT=9911

# --- extra deny regexes (one per line) -----------------------------------
#TITAN_DENY_RULES=$HOME/.titan/deny.rules
